{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "endpoints": {
      "api": {
        "entryPoint": "api",
        "httpsTrigger": {
          "invoker": ["public"]
        }
      }
    },
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "firestore": {
    "rules": "firestore/firestore.rules"
  }
}
